# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase PostgreSQL
# Runtime: transaction pooler (port 6543), recommended for Vercel functions.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DATABASE_POOL_MAX=1

# Migrations: use the direct URL when IPv6 is available, otherwise Supavisor
# session mode (port 5432). Prisma CLI reads DIRECT_URL before DATABASE_URL.
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage
# Create a public bucket with this name. Keep the secret key server-side only.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=galacash

# Upstash Redis (copy the TLS/ioredis URL from the Upstash console)
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST.upstash.io:6379

# Authentication
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_character_secret

# Scheduled monthly bill generation
BILL_GENERATION_SCHEDULE=0 0 1 * *
USE_LOCAL_CRON=false
CRON_SECRET=replace_with_a_random_scheduler_secret

# Frontend and application settings
CORS_ORIGIN=https://YOUR_FRONTEND.vercel.app,http://localhost:5173
KAS_KELAS_AMOUNT=10000
